.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50px;
  background: white;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  font-size: 12px;
  color: #999999;
}

.tab-bar-item.active {
  color: #FF5733;
}

.tab-bar-icon {
  width: 27px;
  height: 27px;
}

.tab-bar-text {
  margin-top: 2px;
}