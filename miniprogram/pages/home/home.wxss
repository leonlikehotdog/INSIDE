/* pages/home/home.wxss */
.container {
  background-color: #f4f4f8;
  padding: 30rpx;
  min-height: 100vh;
}

/* 顶部卡片 */
.header-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 20rpx;
  padding: 40rpx;
  color: white;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.1);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid white;
  margin-right: 20rpx;
}

.welcome-text {
  font-size: 36rpx;
  font-weight: bold;
}

.philosophy-quote {
  font-size: 28rpx;
  text-align: right;
}

.quote-text {
  display: block;
  margin-bottom: 10rpx;
  text-align: left;
}

.quote-author {
  font-style: italic;
  opacity: 0.8;
}

/* 功能导航 */
.nav-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.nav-card {
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease-in-out;
}

.nav-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.card-content {
  display: flex;
  align-items: center;
}

.nav-icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

.text-content {
  display: flex;
  flex-direction: column;
}

.nav-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.nav-subtitle {
  font-size: 22rpx;
  color: #666;
}

/* 内容推荐 */
.recommend-section {
  background-color: #ffffff;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
}

.see-more {
  font-size: 26rpx;
  color: #764ba2;
}

.recommend-scroll {
  white-space: nowrap;
}

.recommend-card {
  display: inline-block;
  width: 400rpx;
  height: 380rpx; /* Fixed height for consistent card display */
  margin-right: 30rpx;
  border-radius: 15rpx;
  overflow: hidden;
  box-shadow: 0 5rpx 10rpx rgba(0, 0, 0, 0.08);
}

.recommend-image {
  width: 100%;
  height: 220rpx;
}

.recommend-video {
  width: 100%;
  height: 220rpx;
}

.recommend-info {
  padding: 20rpx;
}

.recommend-title {
  display: -webkit-box; /* For multi-line ellipsis */
  -webkit-line-clamp: 2; /* Limit to 2 lines */
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 10rpx;
}

.recommend-desc {
  font-size: 24rpx;
  color: #666;
  display: -webkit-box; /* For multi-line ellipsis */
  -webkit-line-clamp: 2; /* Limit to 2 lines */
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}
  