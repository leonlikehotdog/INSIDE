.line-chart-container {
  width: 600rpx;
  height: 400rpx;
  position: relative;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.mood-line-chart {
  width: 100%;
  height: 100%;
}

.tooltip {
  position: absolute;
  padding: 6rpx 12rpx;
  background: #6a82fb;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  transform: translate(-50%, -100%);
}
